{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TokenGauge (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/bin/Debug/net10.0-windows/TokenGauge.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Attach to running TokenGauge",
      "type": "coreclr",
      "request": "attach",
      "processName": "TokenGauge.exe"
    }
  ]
}
